# -----------------------------------------------------------------------------
# PackVote - Environment Configuration
# -----------------------------------------------------------------------------

# Application Operational Mode
# When DEMO_MODE=true, requests automatically fall back to the high-fidelity
# mock engine if real API keys are not provided. Set to false for live inference.
DEMO_MODE=true

# AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Twilio SMS Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15005550006

# App Host & Rate Limiting
PORT=8000
RATE_LIMIT_GLOBAL=100/minute
RATE_LIMIT_AI=20/minute
